# Credentials and local secrets
dimensions_api_key.txt
*.env
.env
.env.*
!*.env.example
*.token
*.pem
*.key
.streamlit/secrets.toml

# Python and editor artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Source and record-level data remain local. Reviewed, non-record-level NMF
# aggregates are explicitly unignored at the end of this file.
/data/*
!/data/README.md
/derived_outputs/*
!/derived_outputs/README.md
/figures/*
!/figures/README.md
/manuscript/*
!/manuscript/README.md

# Raw Dimensions/API material wherever it is written
**/02_dimensions_raw/
**/*_response.json
**/*_retrieval_manifest.json
**/*_metadata_manifest.json
**/*_candidates.csv
**/*_decisions.csv
**/*_assignments_*.csv
**/*.pkl
**/*.pickle

# Local packaged outputs and data extracts
*.zip
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.feather
*.sqlite
*.db

# Data-derived graphics and documents
*.pdf
*.png
*.jpg
*.jpeg
*.svg
*.eps

# Reviewed non-record-level NMF outputs permitted for reproducibility.
# These exceptions must remain below the broad CSV and derived-output rules.
!/derived_outputs/thematic/
!/derived_outputs/thematic/README.md
!/derived_outputs/thematic/topic_model_summary.csv
!/derived_outputs/thematic/topic_sizes.csv
