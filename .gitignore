# Credentials and local secrets
dimensions_api_key.txt
*.env
.env
.env.*
!*.env.example
*.token
*.pem
*.key

# Python and editor artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Source and record-level data remain local. Only named reviewed aggregate releases
# below are permitted; the exceptions must remain after these broad rules.
/data/*
!/data/README.md
/derived_outputs/*
!/derived_outputs/README.md
/figures/*
!/figures/README.md
/manuscript/*

# Raw Dimensions/API material wherever it is written
**/02_dimensions_raw/
**/*_response.json
**/*_retrieval_manifest.json
**/*_metadata_manifest.json
**/*_candidates.csv
**/*_decisions.csv
**/*_assignments_*.csv
**/*.pkl
**/*.pickle

# Local packaged outputs and data extracts
*.zip
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.feather
*.sqlite
*.db

# Data-derived graphics and documents
*.pdf
*.png
*.jpg
*.jpeg
*.svg
*.eps

# Reviewed non-record-level NMF outputs permitted for reproducibility.
!/derived_outputs/thematic/
!/derived_outputs/thematic/README.md
!/derived_outputs/thematic/topic_model_summary.csv
!/derived_outputs/thematic/topic_sizes.csv
!/derived_outputs/thematic/topic_terms.csv
!/derived_outputs/thematic/topic_stability_detail.csv
!/derived_outputs/thematic/bipole_screen.csv
!/derived_outputs/thematic/validation_checks.csv
!/derived_outputs/thematic/topic_2_to_3_crosswalk.csv

# Reviewed aggregate-only certified-results release; no identifiers or record-level files.
!/derived_outputs/released_results/
!/derived_outputs/released_results/README.md
!/derived_outputs/released_results/*.csv

# Reviewed aggregate-only figures used by the public dashboard.
!/figures/manuscript/
!/figures/manuscript/*.png
!/figures/manuscript/*.pdf
!/figures/manuscript/figure_captions.md

# Manuscript source, bibliography, figures, and build products remain outside GitHub.
# The reviewed uploaded draft PDF is the sole exception in this folder.
/manuscript/*
!/manuscript/draft_October2026.pdf
